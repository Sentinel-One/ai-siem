# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# Eval sample logs are fixtures, not runtime output. The blanket `*.log` above
# kept three of them out of the repo while they sat on disk locally, so the
# sdl-log-parser eval suite passed for anyone who had synced and failed for
# anyone who cloned. They are small, committed inputs a test reads.
!plugins/s1-secops-skills/skills/*/evals/samples/*.log

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Claude-specific files #
########################
CLAUDE.md
.claude/
*.claude
.cursorrules
.claude-config

# Local documentation #
#######################
LOCAL_*.md
LOCAL_*.txt
*_LOCAL_ONLY.*
# --- s1-secops-skills plugin: keep its CLAUDE.md (operating instructions) tracked ---
!plugins/s1-secops-skills/CLAUDE.md

# --- Secrets: never commit real credentials ---
**/credentials.json
*.env
.env.*
*.pem
*.key
__pycache__/
*.pyc
*.pyo
